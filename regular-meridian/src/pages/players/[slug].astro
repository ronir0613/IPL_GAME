---
import Layout from '../../layouts/Layout.astro';
import { slugify } from '../../lib/slugify';
import { getCanonicalSlug } from '../../lib/canonical';
import { formatOvers, getPlayerStatsBySlug } from '../../lib/playerStats';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const filePath = path.join(process.cwd(), 'public', 'ipl_v10_FINAL.json');
  const rawData = fs.readFileSync(filePath, 'utf-8');
  const allPlayers = JSON.parse(rawData);

  // Group by slugified name to handle spacing/case differences naturally
  const playerGroups = new Map<string, { names: Set<string>, records: any[] }>();
  for (const p of allPlayers) {
    if (p.name == null || p.team == null || p.rating == null || p.season == null) continue;
    if (typeof p.name !== 'string' || typeof p.team !== 'string' || typeof p.rating !== 'number' || typeof p.season !== 'number') continue;
    
    const slug = slugify(p.name);
    if (!playerGroups.has(slug)) {
      playerGroups.set(slug, { names: new Set(), records: [] });
    }
    const group = playerGroups.get(slug)!;
    group.names.add(p.name.trim());
    group.records.push(p);
  }

  const paths = [];
  for (const [slug, group] of playerGroups.entries()) {
    // Determine canonical name, max rating and primary role from best record
    let maxRating = -1;
    let bestRecord = group.records[0];
    
    for (const r of group.records) {
      if (r.rating > maxRating) {
        maxRating = r.rating;
        bestRecord = r;
      }
    }
    
    // Choose canonical name from the best record
    const canonicalName = bestRecord.name.trim();

    paths.push({
      params: { slug },
      props: {
        name: canonicalName,
        role: bestRecord.role,
        maxRating,
        isOverseas: !!bestRecord.is_overseas,
        records: group.records.sort((a: any, b: any) => b.season - a.season),
        bestTeam: bestRecord.team
      }
    });
  }

  return paths;
}

interface RecordData {
  season: number;
  team: string;
  role: string;
  rating: number;
}
const { name, role, maxRating, isOverseas, records, bestTeam } = Astro.props as { name: string; role: string; maxRating: number; isOverseas: boolean; records: RecordData[]; bestTeam: string };

// Role Expansion
const roleFull = ({
  BAT: 'Batter',
  BOWL: 'Bowler',
  AR: 'All-Rounder',
  WK: 'Wicketkeeper'
} as Record<string, string>)[role] || role;

const title = `${name} - 16-0play Cricket Ratings & Stats`;
const description = `View ${name}'s historical ratings, roles, and statistics in 16-0play. Build your ultimate cricket XI with top players like ${name}.`;
const canonical = new URL(`/players/${getCanonicalSlug(Astro.params.slug ?? '')}/`, Astro.site ?? Astro.url).href;
const careerStats = getPlayerStatsBySlug(Astro.params.slug ?? '');
const ratingTier = maxRating >= 90 ? 'Elite' : maxRating >= 80 ? 'Star' : 'Role Player';
const seasonRange = careerStats?.firstSeason != null && careerStats.lastSeason != null
  ? careerStats.firstSeason === careerStats.lastSeason
    ? `in ${careerStats.firstSeason}`
    : `from ${careerStats.firstSeason} to ${careerStats.lastSeason}`
  : 'with the season span unavailable in the source data';
const introVariants = careerStats ? [
  `${name} is listed as a ${roleFull.toLowerCase()} for ${bestTeam} in the 16-0 Play database, with a ${ratingTier} rating of ${maxRating}. Cricsheet records ${careerStats.matches} IPL matches ${seasonRange}, including ${careerStats.batting.runs} runs and ${careerStats.bowling.wickets} wickets.`,
  `The 16-0 Play profile for ${name} shows a peak rating of ${maxRating} (${ratingTier}) and a ${roleFull.toLowerCase()} role with ${bestTeam}. Their matched Cricsheet record covers ${careerStats.matches} IPL matches ${seasonRange}, with ${careerStats.batting.runs} runs and ${careerStats.bowling.wickets} wickets.`,
  `${name}'s highest 16-0 Play rating is ${maxRating}, placing this profile in the ${ratingTier} tier; the listed role is ${roleFull.toLowerCase()} and the peak-rated team is ${bestTeam}. In the Cricsheet IPL data, the matched record totals ${careerStats.matches} matches ${seasonRange}, ${careerStats.batting.runs} runs and ${careerStats.bowling.wickets} wickets.`,
  `For ${bestTeam}, ${name} has a ${roleFull.toLowerCase()} profile with a peak 16-0 Play rating of ${maxRating} (${ratingTier}). Cricsheet's IPL records list ${careerStats.matches} appearances ${seasonRange}, with ${careerStats.batting.runs} runs and ${careerStats.bowling.wickets} wickets.`,
  `${name} appears in the 16-0 Play database as a ${roleFull.toLowerCase()} for ${bestTeam}, rated ${maxRating} at peak (${ratingTier}). The corresponding Cricsheet IPL record covers ${careerStats.matches} matches ${seasonRange}, with ${careerStats.batting.runs} runs and ${careerStats.bowling.wickets} wickets.`,
] : [];
let introHash = 0;
for (const character of Astro.params.slug ?? '') introHash = (introHash * 31 + character.charCodeAt(0)) >>> 0;
const careerIntro = introVariants.length ? introVariants[introHash % introVariants.length] : '';
const statValue = (value: number | null) => value === null ? '—' : value.toFixed(2);
---

<Layout title={title} description={description} canonical={canonical}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-8">
      <a href="/players" class="text-yellow-600 hover:text-yellow-500 font-medium text-sm flex items-center gap-1">
        &larr; Back to Players Database
      </a>
    </div>

    <div class="bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] rounded-2xl overflow-hidden shadow-lg">
      <div class="p-8 md:p-12 border-b border-[var(--color-hairline)] flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <h1 class="text-4xl md:text-5xl font-black text-[var(--color-ink)] tracking-tight">{name}</h1>
          <p class="text-xl text-[var(--color-mute)] mt-2 font-medium">{roleFull} &bull; Peak Rating: {maxRating}</p>
        </div>
        <div class="shrink-0">
          <div class="w-24 h-24 md:w-32 md:h-32 rounded-full flex items-center justify-center text-3xl md:text-5xl font-black" 
               style={`background-color: ${maxRating >= 90 ? '#ef4444' : maxRating >= 80 ? '#f59e0b' : '#3b82f6'}; color: white;`}>
            {maxRating}
          </div>
        </div>
      </div>

      <div class="p-8 md:p-12 text-[var(--color-body)] text-lg leading-relaxed">
        <h2 class="text-2xl font-bold text-[var(--color-ink)] mb-4">Player Profile</h2>
        <p class="mb-6">
          <strong>{name}</strong> is a highly rated <strong>{roleFull.toLowerCase()}</strong> in the 16-0play database, reaching a peak overall rating of <strong>{maxRating}</strong> during the <strong>{records.find((r: any) => r.rating === maxRating)?.season}</strong> season with <strong>{bestTeam}</strong>. 
        </p>
        <p>
          In the 16-0play simulation engine, building a balanced squad is critical. As a {roleFull.toLowerCase()}, {name} plays a vital role in determining team balance.
          {isOverseas && " As an overseas player, including them in your XI requires careful management of the strict 4-overseas player limit to avoid simulation penalties."}
        </p>
      </div>

      {careerStats && (
        <section class="bg-[var(--color-canvas-soft)] p-8 md:p-12 border-t border-[var(--color-hairline)]" aria-labelledby="ipl-career-heading">
          <h2 id="ipl-career-heading" class="text-2xl font-bold text-[var(--color-ink)] mb-4">Career in the IPL</h2>
          <p class="mb-8 text-[var(--color-body)] leading-relaxed">{careerIntro}</p>

          <h3 class="text-lg font-bold text-[var(--color-ink)] mb-3">Batting</h3>
          <div role="region" aria-label="Batting statistics table; scroll horizontally on narrow screens" tabindex="0" class="overflow-x-auto max-w-full mb-8 rounded-lg border border-[var(--color-hairline)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-yellow-500">
            <table class="min-w-[920px] w-full text-left border-collapse text-sm">
              <caption class="sr-only">IPL batting career statistics for {name}</caption>
              <thead class="bg-[var(--color-canvas)]">
                <tr class="border-b border-[var(--color-hairline)]">
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Matches</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Innings</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Runs</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Balls faced</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Average</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Strike rate</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">50s</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">100s</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">High score</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">4s</th>
                  <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">6s</th>
                </tr>
              </thead>
              <tbody>
                <tr class="bg-[var(--color-canvas-soft)] text-[var(--color-ink)] tabular-nums">
                  <td class="py-3 px-3">{careerStats.matches}</td>
                  <td class="py-3 px-3">{careerStats.batting.innings}</td>
                  <td class="py-3 px-3 font-bold">{careerStats.batting.runs}</td>
                  <td class="py-3 px-3">{careerStats.batting.ballsFaced}</td>
                  <td class="py-3 px-3">{statValue(careerStats.batting.average)}</td>
                  <td class="py-3 px-3">{statValue(careerStats.batting.strikeRate)}</td>
                  <td class="py-3 px-3">{careerStats.batting.fifties}</td>
                  <td class="py-3 px-3">{careerStats.batting.hundreds}</td>
                  <td class="py-3 px-3">{careerStats.batting.highestScore}</td>
                  <td class="py-3 px-3">{careerStats.batting.fours}</td>
                  <td class="py-3 px-3">{careerStats.batting.sixes}</td>
                </tr>
              </tbody>
            </table>
          </div>

          {careerStats.bowling.legalBalls >= 60 && (
            <>
              <h3 class="text-lg font-bold text-[var(--color-ink)] mb-3">Bowling</h3>
              <div role="region" aria-label="Bowling statistics table; scroll horizontally on narrow screens" tabindex="0" class="overflow-x-auto max-w-full mb-8 rounded-lg border border-[var(--color-hairline)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-yellow-500">
                <table class="min-w-[640px] w-full text-left border-collapse text-sm">
                  <caption class="sr-only">IPL bowling career statistics for {name}</caption>
                  <thead class="bg-[var(--color-canvas)]">
                    <tr class="border-b border-[var(--color-hairline)]">
                      <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Matches</th>
                      <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Overs</th>
                      <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Runs</th>
                      <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Wickets</th>
                      <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Economy</th>
                      <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">Best</th>
                      <th scope="col" class="py-3 px-3 font-bold text-[var(--color-mute)]">3-wicket hauls</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr class="bg-[var(--color-canvas-soft)] text-[var(--color-ink)] tabular-nums">
                      <td class="py-3 px-3">{careerStats.bowling.matches}</td>
                      <td class="py-3 px-3">{formatOvers(careerStats.bowling.legalBalls)}</td>
                      <td class="py-3 px-3">{careerStats.bowling.runsConceded}</td>
                      <td class="py-3 px-3 font-bold">{careerStats.bowling.wickets}</td>
                      <td class="py-3 px-3">{statValue(careerStats.bowling.economy)}</td>
                      <td class="py-3 px-3">{careerStats.bowling.bestBowling ? `${careerStats.bowling.bestBowling.wickets}/${careerStats.bowling.bestBowling.runs}` : '—'}</td>
                      <td class="py-3 px-3">{careerStats.bowling.threeWicketHaulsOrBetter}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </>
          )}

          <p class="text-xs text-[var(--color-mute)]">IPL ball-by-ball data: <a class="underline underline-offset-2 hover:text-yellow-600" href="https://cricsheet.org/">Cricsheet</a>. Player identifiers: its Register, licensed under <a class="underline underline-offset-2 hover:text-yellow-600" href="http://opendatacommons.org/licenses/by/1.0/">ODC-BY 1.0</a>.</p>
        </section>
      )}

      <div class="bg-[var(--color-canvas)] p-8 md:p-12 border-t border-[var(--color-hairline)]">
        <h3 class="text-2xl font-bold text-[var(--color-ink)] mb-6">Career History (16-0play Database)</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse">
            <thead>
              <tr class="border-b border-[var(--color-hairline)]">
                <th class="py-3 px-4 text-sm font-bold text-[var(--color-mute)] uppercase tracking-wider">Season</th>
                <th class="py-3 px-4 text-sm font-bold text-[var(--color-mute)] uppercase tracking-wider">Team</th>
                <th class="py-3 px-4 text-sm font-bold text-[var(--color-mute)] uppercase tracking-wider">Role</th>
                <th class="py-3 px-4 text-sm font-bold text-[var(--color-mute)] uppercase tracking-wider text-right">Rating</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-[var(--color-hairline)]">
              {records.map((record: any) => (
                <tr class="hover:bg-[var(--color-canvas-soft-2)] transition-colors">
                  <td class="py-4 px-4 text-[var(--color-ink)] font-medium">{record.season}</td>
                  <td class="py-4 px-4 text-yellow-600 font-medium">
                    <a href={`/teams/${slugify(record.team)}`} class="hover:underline">{record.team}</a>
                  </td>
                  <td class="py-4 px-4 text-[var(--color-mute)]">{record.role}</td>
                  <td class="py-4 px-4 text-[var(--color-ink)] font-bold text-right">{record.rating}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</Layout>
