---
import Layout from '../../layouts/Layout.astro';
import { slugify } from '../../lib/slugify';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const filePath = path.join(process.cwd(), 'public', 'ipl_v10_FINAL.json');
  const rawData = fs.readFileSync(filePath, 'utf-8');
  const allPlayers = JSON.parse(rawData);

  // Group by team
  const teamGroups = new Map<string, any[]>();
  for (const p of allPlayers) {
    if (!p.team) continue;
    const teamName = p.team.trim();
    if (!teamGroups.has(teamName)) {
      teamGroups.set(teamName, []);
    }
    teamGroups.get(teamName)!.push(p);
  }

  const paths = [];
  for (const [teamName, records] of teamGroups.entries()) {
    // Deduplicate players within the team to find unique representatives
    const playerMap = new Map<string, any>();
    for (const r of records) {
      const pName = r.name.trim();
      if (!playerMap.has(pName)) {
        playerMap.set(pName, r);
      } else {
        if (r.rating > playerMap.get(pName).rating) {
          playerMap.set(pName, r);
        }
      }
    }

    const uniquePlayers = Array.from(playerMap.values()).sort((a: any, b: any) => b.rating - a.rating);

    paths.push({
      params: { slug: slugify(teamName) },
      props: {
        teamName,
        players: uniquePlayers
      }
    });
  }

  return paths;
}

interface PlayerData {
  name: string;
  role: string;
  rating: number;
}
const { teamName, players } = Astro.props as { teamName: string; players: PlayerData[] };

const topPlayers = players.slice(0, 5);

const title = `${teamName} - Franchise Roster & Stats in 16-0play`;
const description = `View the all-time 16-0play roster for ${teamName}. Discover their highest-rated players, team strengths, and build your ultimate XI.`;
---

<Layout title={title} description={description}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-20">
    <div class="mb-8">
      <a href="/teams" class="text-yellow-600 hover:text-yellow-500 font-medium text-sm flex items-center gap-1">
        &larr; Back to Franchises
      </a>
    </div>

    <div class="bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] rounded-2xl overflow-hidden shadow-lg">
      <div class="p-8 md:p-12 border-b border-[var(--color-hairline)] bg-[var(--color-canvas)]">
        <h1 class="text-4xl md:text-5xl font-black text-[var(--color-ink)] tracking-tight">{teamName}</h1>
        <p class="text-xl text-[var(--color-mute)] mt-3 font-medium">16-0play Franchise Database</p>
      </div>

      <div class="p-8 md:p-12 text-[var(--color-body)] text-lg leading-relaxed">
        <h2 class="text-2xl font-bold text-[var(--color-ink)] mb-4">Franchise Overview</h2>
        <p class="mb-6">
          <strong>{teamName}</strong> is one of the distinct franchises available in the 16-0play database. The strength of a franchise in the simulation engine is heavily dependent on the depth and balance of its historical roster. 
        </p>
        <p class="mb-6">
          When building a custom XI in 16-0play, drafting players from <strong>{teamName}</strong> can provide significant strategic advantages. With legendary performers like <strong>{topPlayers.map((p: any) => p.name).join(', ')}</strong> anchoring the database, this franchise offers versatile options across batting, bowling, and all-rounder roles.
        </p>
        <p>
          Selecting players with existing team chemistry can impact match simulation outcomes. Balancing high-rated stars with solid role players from the {teamName} roster is a proven strategy for achieving a perfect 16-0 season.
        </p>
      </div>

      <div class="p-8 md:p-12 border-t border-[var(--color-hairline)] bg-[var(--color-canvas)]">
        <h3 class="text-2xl font-bold text-[var(--color-ink)] mb-6">All-Time Roster (Peak Ratings)</h3>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {players.map((player: any) => (
            <a href={`/players/${slugify(player.name)}`} class="flex items-center justify-between p-4 bg-[var(--color-canvas-soft)] border border-[var(--color-hairline)] rounded-xl hover:border-yellow-500/50 hover:bg-[var(--color-canvas-soft-2)] transition-all group">
              <div>
                <p class="font-bold text-[var(--color-ink)] group-hover:text-yellow-600 transition-colors">{player.name}</p>
                <p class="text-xs text-[var(--color-mute)] font-medium uppercase tracking-wider">{player.role}</p>
              </div>
              <div class="text-lg font-black" style={`color: ${player.rating >= 90 ? '#ef4444' : player.rating >= 80 ? '#f59e0b' : '#3b82f6'}`}>
                {player.rating}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</Layout>
