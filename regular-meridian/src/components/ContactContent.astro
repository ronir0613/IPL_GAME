<section class="w-full px-6 py-14 sm:py-20">
  <div class="mx-auto max-w-4xl">
    <header class="mb-10 max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tight text-[var(--color-ink)] sm:text-5xl">Contact us</h1>
      <p class="mt-5 text-lg leading-8 text-[var(--color-body)]">Questions or feedback? Send us a message.</p>
      <p class="mt-3 text-[var(--color-body)]">Or email <a class="font-medium text-[var(--color-link)] underline underline-offset-4 hover:text-[var(--color-link-deep)]" href="mailto:curatedclass13@gmail.com">curatedclass13@gmail.com</a>.</p>
    </header>

    <form action="https://formsubmit.co/curatedclass13@gmail.com" method="post" class="max-w-2xl space-y-5 rounded-xl border border-[var(--color-hairline)] bg-[var(--color-canvas)] p-6 sm:p-8">
      <input type="hidden" name="_subject" value="Message from 16-0 Play" />
      <div>
        <label for="contact-name" class="mb-2 block font-medium text-[var(--color-ink)]">Name</label>
        <input id="contact-name" name="name" autocomplete="name" required class="w-full rounded-md border border-[var(--color-hairline-strong)] bg-[var(--color-canvas)] px-4 py-3 text-[var(--color-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-link)]" />
      </div>
      <div>
        <label for="contact-email" class="mb-2 block font-medium text-[var(--color-ink)]">Email address</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" required class="w-full rounded-md border border-[var(--color-hairline-strong)] bg-[var(--color-canvas)] px-4 py-3 text-[var(--color-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-link)]" />
      </div>
      <div>
        <label for="contact-message" class="mb-2 block font-medium text-[var(--color-ink)]">Message</label>
        <textarea id="contact-message" name="message" rows="6" required class="w-full resize-y rounded-md border border-[var(--color-hairline-strong)] bg-[var(--color-canvas)] px-4 py-3 text-[var(--color-ink)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-link)]"></textarea>
      </div>
      <p id="contact-privacy" class="text-sm leading-6 text-[var(--color-body)]">FormSubmit delivers this message to us. Do not include passwords or sensitive information. Read our <a class="font-medium text-[var(--color-link)] underline underline-offset-4 hover:text-[var(--color-link-deep)]" href="/privacy-policy">Privacy Policy</a>.</p>
      <button type="submit" aria-describedby="contact-privacy" class="inline-flex min-h-11 items-center justify-center rounded-md bg-[var(--color-primary)] px-5 py-3 font-semibold text-[var(--color-on-primary)] transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-link)]">Send message</button>
    </form>
  </div>
</section>
