---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	hideHeader?: boolean;
	canonical?: string;
	showAds?: boolean;
}

const { 
	title = "16-0 Play | The Ultimate Cricket Strategy Game",
	description = "Play the ultimate 16-0 cricket simulator. Build your greatest playing XI, master cricket team management, and achieve the perfect 16-0 challenge.",
	hideHeader = false,
	canonical: canonicalOverride,
	showAds = false
} = Astro.props;

const canonical = canonicalOverride ?? new URL(
	Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`,
	Astro.site ?? Astro.url
).href;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const currentSection = currentPath === '/' ? 'play'
	: currentPath.startsWith('/players') ? 'players'
	: currentPath.startsWith('/teams') ? 'teams'
	: currentPath.startsWith('/rankings') ? 'rankings'
	: currentPath === '/game-modes' ? 'game-modes'
	: currentPath.startsWith('/guides') ? 'guides'
	: '';
const navCurrent = (section: string, route: string) =>
	currentSection === section ? (currentPath === route ? 'page' : 'location') : undefined;
---

<!doctype html>
<html lang="en">
	<head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-DC032Y6PFZ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-DC032Y6PFZ');
    </script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="16 & 0" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		
    <slot name="head" />

		<script is:inline>
			const theme = (() => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
					return 'dark';
				}
				return 'light';
			})();
			if (theme === 'dark') {
				document.documentElement.classList.add('dark');
			} else {
				document.documentElement.classList.remove('dark');
			}
			window.localStorage.setItem('theme', theme);
		</script>
		
		<script is:inline>
			// Handle chunk loading and dynamic import errors due to redeployments
			window.addEventListener('unhandledrejection', (event) => {
				if (
					event.reason &&
					(event.reason.message?.includes('Failed to fetch dynamically imported module') ||
					 event.reason.name === 'ChunkLoadError')
				) {
					console.warn('Dynamic import failed, reloading page to get latest version...', event.reason);
					window.location.reload();
				}
			});

			window.addEventListener('vite:preloadError', (event) => {
				console.warn('Vite preload error detected, reloading page to get latest version...', event);
				window.location.reload();
			});

			window.addEventListener('error', (event) => {
				// If a script resource fails to load, check if it's in the _astro assets directory
				if (event.target && event.target.tagName === 'SCRIPT') {
					const src = event.target.src || '';
					if (src.includes('/_astro/')) {
						console.warn('Failed to load asset script, reloading page to get latest version...', src);
						window.location.reload();
					}
				}
			}, true); // Use capture phase to catch script element loading errors
		</script>
	
    <!-- Manual owner check: keep Auto ads off or exclude the game in AdSense. -->
    {showAds && (
      <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3180090639225904" crossorigin="anonymous"></script>
    )}
	</head>
	<body class="min-h-screen bg-[var(--color-canvas)] text-[var(--color-ink)] flex flex-col">
    <!-- Global Navigation -->
    {!hideHeader && (
      <header class="w-full bg-[var(--color-canvas-soft)] border-b border-[var(--color-hairline)] sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
          <a href="/" class="text-xl font-black tracking-tight text-[var(--color-ink)] flex items-center gap-2">
            <span class="text-yellow-500">16-0</span>PLAY
          </a>
          <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-[var(--color-mute)]">
            <a href="/" aria-current={navCurrent('play', '/')} class:list={["hover:text-yellow-600 transition-colors", currentSection === 'play' && "text-[var(--color-ink)] underline decoration-yellow-500 decoration-2 underline-offset-8"]}>Play</a>
            <a href="/players" aria-current={navCurrent('players', '/players')} class:list={["hover:text-yellow-600 transition-colors", currentSection === 'players' && "text-[var(--color-ink)] underline decoration-yellow-500 decoration-2 underline-offset-8"]}>Players</a>
            <a href="/teams" aria-current={navCurrent('teams', '/teams')} class:list={["hover:text-yellow-600 transition-colors", currentSection === 'teams' && "text-[var(--color-ink)] underline decoration-yellow-500 decoration-2 underline-offset-8"]}>Teams</a>
            <a href="/rankings" aria-current={navCurrent('rankings', '/rankings')} class:list={["hover:text-yellow-600 transition-colors", currentSection === 'rankings' && "text-[var(--color-ink)] underline decoration-yellow-500 decoration-2 underline-offset-8"]}>Rankings</a>
            <a href="/game-modes" aria-current={navCurrent('game-modes', '/game-modes')} class:list={["hover:text-yellow-600 transition-colors", currentSection === 'game-modes' && "text-[var(--color-ink)] underline decoration-yellow-500 decoration-2 underline-offset-8"]}>Game Modes</a>
            <a href="/guides/" aria-current={navCurrent('guides', '/guides')} class:list={["hover:text-yellow-600 transition-colors", currentSection === 'guides' && "text-[var(--color-ink)] underline decoration-yellow-500 decoration-2 underline-offset-8"]}>Guides</a>
          </nav>
          <details class="group relative md:hidden">
            <summary class="list-none cursor-pointer rounded-md border border-[var(--color-hairline)] bg-[var(--color-canvas-soft-2)] px-3 py-2 text-sm font-semibold text-[var(--color-ink)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-yellow-500">Menu</summary>
            <nav aria-label="Mobile site navigation" class="absolute right-0 top-full z-50 mt-2 flex min-w-48 flex-col rounded-lg border border-[var(--color-hairline)] bg-[var(--color-canvas-soft)] p-2 text-sm font-medium shadow-lg">
              <a href="/" aria-current={navCurrent('play', '/')} class:list={["rounded px-3 py-2 hover:bg-[var(--color-canvas-soft-2)]", currentSection === 'play' && "font-bold text-[var(--color-ink)]"]}>Play</a>
              <a href="/players" aria-current={navCurrent('players', '/players')} class:list={["rounded px-3 py-2 hover:bg-[var(--color-canvas-soft-2)]", currentSection === 'players' && "font-bold text-[var(--color-ink)]"]}>Players</a>
              <a href="/teams" aria-current={navCurrent('teams', '/teams')} class:list={["rounded px-3 py-2 hover:bg-[var(--color-canvas-soft-2)]", currentSection === 'teams' && "font-bold text-[var(--color-ink)]"]}>Teams</a>
              <a href="/rankings" aria-current={navCurrent('rankings', '/rankings')} class:list={["rounded px-3 py-2 hover:bg-[var(--color-canvas-soft-2)]", currentSection === 'rankings' && "font-bold text-[var(--color-ink)]"]}>Rankings</a>
              <a href="/game-modes" aria-current={navCurrent('game-modes', '/game-modes')} class:list={["rounded px-3 py-2 hover:bg-[var(--color-canvas-soft-2)]", currentSection === 'game-modes' && "font-bold text-[var(--color-ink)]"]}>Game Modes</a>
              <a href="/guides/" aria-current={navCurrent('guides', '/guides')} class:list={["rounded px-3 py-2 hover:bg-[var(--color-canvas-soft-2)]", currentSection === 'guides' && "font-bold text-[var(--color-ink)]"]}>Guides</a>
            </nav>
          </details>
        </div>
      </header>
    )}

    <!-- Main Content -->
    <main class="flex-grow flex flex-col w-full">
		  <slot />
    </main>

    <!-- Global Footer -->
    <footer class="w-full bg-[var(--color-canvas-soft)] border-t border-[var(--color-hairline)] py-12 mt-auto">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-4 gap-8 text-sm text-[var(--color-body)]">
        <div class="col-span-1 md:col-span-2">
          <h3 class="text-[var(--color-ink)] font-bold text-lg mb-3 tracking-wider">16-0 PLAY</h3>
          <p class="text-[var(--color-mute)] leading-relaxed text-xs max-w-md">
            The ultimate cricket strategy and team-building simulator. Build your greatest playing XI and achieve the impossible perfect season.
          </p>
        </div>
        <div>
          <h3 class="text-[var(--color-ink)] font-bold mb-4 tracking-wider uppercase text-xs">Game Hub</h3>
          <div class="flex flex-col space-y-2 text-[var(--color-mute)] font-medium text-xs">
            <a href="/players" class="hover:text-yellow-600 transition-colors">Player Database</a>
            <a href="/teams" class="hover:text-yellow-600 transition-colors">Franchises</a>
            <a href="/rankings" class="hover:text-yellow-600 transition-colors">Rankings</a>
            <a href="/guides/" class="hover:text-yellow-600 transition-colors">Guides</a>
            <a href="/game-modes" class="hover:text-yellow-600 transition-colors">Game Modes</a>
            <a href="/rating-system" class="hover:text-yellow-600 transition-colors">Rating System</a>
          </div>
        </div>
        <div>
          <h3 class="text-[var(--color-ink)] font-bold mb-4 tracking-wider uppercase text-xs">Legal & Info</h3>
          <div class="flex flex-col space-y-2 text-[var(--color-mute)] font-medium text-xs">
            <a href="/about" class="hover:text-yellow-600 transition-colors">About Us</a>
            <a href="/contact" class="hover:text-yellow-600 transition-colors">Contact Us</a>
            <a href="/privacy-policy" class="hover:text-yellow-600 transition-colors">Privacy Policy</a>
            <a href="/terms-and-conditions" class="hover:text-yellow-600 transition-colors">Terms & Conditions</a>
          </div>
        </div>
      </div>
      <div class="max-w-6xl mx-auto px-4 sm:px-6 mt-12 pt-6 border-t border-[var(--color-hairline)] flex flex-col md:flex-row justify-between items-center gap-2 text-xs text-[var(--color-mute)]">
        <p>&copy; {new Date().getFullYear()} 16-0play. All rights reserved.</p>
        <p>Not affiliated with the IPL, BCCI, or any franchise.</p>
      </div>
    </footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
